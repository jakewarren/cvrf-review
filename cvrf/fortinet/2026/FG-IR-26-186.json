    "cvrf:DocumentNotes": {
      "cvrf:Note": [
        {
          "#text": "CVE-2026-109618PHP uses longjmp() for out-of-memory (OOM) errors to exit the current context and abort handling of the request. Some contexts may not properly account for this scenario and leave request memory in an uninitialized state before performing an allocation. The subsequent request cleanup procedure may read or branch on this memory. Multiple OOM strategies can consistently trigger this condition and lead to remote code execution (RCE).",
          "@Ordinal": "1",
          "@Title": "Summary",
          "@Type": "Summary"
        },
